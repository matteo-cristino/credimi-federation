{
  "name": "credimi-federation",
  "version": "0.1.0",
  "description": "OpenID Federation 1.0 Trust Anchor for Credimi development and interoperability testing.",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "credimi-federation": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "cli": "node dist/cli.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && stylelint --allow-empty-input \"public/**/*.css\" && pnpm typecheck && prettier --check .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fastify/static": "10.1.12",
    "@oidfed/authority": "2.0.0",
    "@oidfed/core": "2.0.0",
    "fastify": "5.12.8",
    "jose": "6.2.13",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@openid-federation/core": "0.2.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "stylelint": "18.1.0",
    "stylelint-value-no-unknown-custom-properties": "6.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
